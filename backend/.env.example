PORT=4000

# PostgreSQL connection
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=vunaflow_db

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Uploaded file storage (local disk for this build)
UPLOAD_DIR=uploads

# Used to build absolute URLs for uploaded files, e.g. http://localhost:4000
BASE_URL=http://localhost:4000
